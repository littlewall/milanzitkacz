---
import Footer from '../components/layout/footer/footer.astro';
import NavBar from '../components/layout/navbar/navbar.astro';
import Layout from '../layouts/Layout.astro';
import {SupportedLanguage} from '../lib/translation/i18nTypes';
import {createTranslator} from '../lib/translation/translations';
import styles from './kdo-jsem/index.module.css';

const lang = (Astro.currentLocale || 'cs') as SupportedLanguage;
const translate = createTranslator(lang);
const currentPath = Astro.url.pathname;

---

<Layout title={translate('aboutme.meta.title')} description={translate('aboutme.meta.description')}>
    <NavBar lang={lang} currentPath={currentPath} />

    <div class={styles.page}>
        <div class={styles.blob}>
            <svg
                id="10015.io"
                viewBox="0 0 480 480"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
            >
                <defs>
                    <clipPath id="blob">
                        <path
                            fill="#474bff"
                            d="M413.5,302.5Q390,365,335.5,417.5Q281,470,205.5,450Q130,430,88,370.5Q46,311,35,236.5Q24,162,74.5,101.5Q125,41,203,24.5Q281,8,337,59.5Q393,111,415,175.5Q437,240,413.5,302.5Z"
                        />
                    </clipPath>
                </defs>
                <image
                    x="0"
                    y="0"
                    width="100%"
                    height="100%"
                    clip-path="url(#blob)"
                    xlink:href="/images/portrait/whoami.png"
                    preserveAspectRatio="xMidYMid slice"
                >
                </image>
            </svg>
        </div>
        <div class={styles.content}>
            <p set:html={translate('aboutme.content.paragraph1')} />
            <p set:html={translate('aboutme.content.paragraph2')} />
            <p set:html={translate('aboutme.content.paragraph3')} />
            <p set:html={translate('aboutme.content.paragraph4')} />
            <p set:html={translate('aboutme.content.paragraph5')} />
            <p set:html={translate('aboutme.content.paragraph6')} />
            <p set:html={translate('aboutme.content.paragraph7')} />
            <p set:html={translate('aboutme.content.paragraph8')} />
        </div>
    </div>
    <Footer />
</Layout>
