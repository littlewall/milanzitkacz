---
import CardLink from '../../components/cardLink/cardLink.astro';
import Footer from '../../components/layout/footer/footer.astro';
import NavBar from '../../components/layout/navbar/navbar.astro';
import Layout from '../../layouts/Layout.astro';
import {SupportedLanguage} from '../../lib/translation/i18nTypes';
import {createTranslator} from '../../lib/translation/translations';
import styles from './index.module.css';

const lang = (Astro.currentLocale || 'cs') as SupportedLanguage;
const translate = createTranslator(lang);
const currentPath = Astro.url.pathname;
---

<Layout title={translate('whatido.meta.title')} description={translate('whatido.meta.description')}>
    <NavBar lang={lang} currentPath={currentPath} />

    <main class={styles.page}>
        <div class={styles.content}>
            <div class={styles.cards}>
                <CardLink
                    heading={translate('whatido.content.cards.music.heading')}
                    text={translate('whatido.content.cards.music.text')}
                    link="/co-delam/hudba"
                    lang={lang}
                />
                <CardLink
                    heading={translate('whatido.content.cards.musicals.heading')}
                    text={translate('whatido.content.cards.musicals.text')}
                    link="/co-delam/muzikaly"
                    lang={lang}
                />
                <CardLink
                    heading={translate('whatido.content.cards.texts.heading')}
                    text={translate('whatido.content.cards.texts.text')}
                    link="/co-delam/texty"
                    lang={lang}
                />
            </div>
            <div class={styles.blob}>
                <svg
                    id="10015.io"
                    viewBox="0 0 480 480"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                >
                    <defs>
                        <clipPath id="blob">
                            <path
                                fill="#474bff"
                                d="M418.5,301.5Q363,363,301.5,395Q240,427,159.5,414Q79,401,41.5,320.5Q4,240,53,171Q102,102,171,73.5Q240,45,309,73.5Q378,102,426,171Q474,240,418.5,301.5Z"
                            />
                        </clipPath>
                    </defs>
                    <image
                        x="0"
                        y="0"
                        width="100%"
                        height="100%"
                        clip-path="url(#blob)"
                        xlink:href="/images/portrait/whatido.png"
                        preserveAspectRatio="xMidYMid slice"
                    >
                    </image>
                </svg>
            </div>
        </div>
    </main>
    <Footer />
</Layout>
